# ──────────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────────
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto_secret
POSTGRES_DB=crypto_pipeline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ──────────────────────────────────────────────────────────────
# Kafka
# ──────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ──────────────────────────────────────────────────────────────
# Spark
# ──────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077

# ──────────────────────────────────────────────────────────────
# Data source toggle
# live      → ingestion/websocket/binance_consumer.py
# synthetic → ingestion/websocket/synthetic_consumer.py
# ──────────────────────────────────────────────────────────────
DATA_SOURCE=live

# ──────────────────────────────────────────────────────────────
# Dashboard toggle
# Options: grafana | streamlit | evidence
#
# COMPOSE_PROFILES activates the matching docker-compose profile.
# Keep DASHBOARD_TYPE and COMPOSE_PROFILES in sync.
# ──────────────────────────────────────────────────────────────
DASHBOARD_TYPE=grafana
COMPOSE_PROFILES=grafana

# ──────────────────────────────────────────────────────────────
# Grafana (only used when DASHBOARD_TYPE=grafana)
# ──────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_secret
GF_SERVER_HTTP_PORT=3000
